{
  "manifest_version": 3,
  "name": "X TikTok Feed",
  "version": "1.0",
  "description": "TikTok-style full-screen video feed for x.com — navigate with ↑↓ or scroll",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
